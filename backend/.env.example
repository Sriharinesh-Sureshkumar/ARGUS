# Copy to .env (git-ignored) to override, or export directly before
# starting uvicorn. No secrets live here -- ARGUS has none.

# Python logging level (main.py). INFO by default; DEBUG additionally
# emits per-request /analyze timing and the SHAP cache hit/miss line
# for GET /player (db/crud.py) -- quiet at INFO, per Phase 4.3.
LOG_LEVEL=INFO

# Comma-separated list of origins the frontend is allowed to call the
# API from (main.py, Phase 4.5b). Defaults to the two forms of the
# documented frontend port when unset:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Example if you run the frontend on a different port, e.g. 5180:
# CORS_ORIGINS=http://localhost:5180
