# Copy to .env.local (git-ignored) to override.
# Default if unset: http://localhost:8000/api/v1 (uvicorn default port).
#
# This is a BUILD-TIME value (Vite inlines import.meta.env.* into the
# bundle at `npm run build`/`vite build`, Phase 5.3) -- it is NOT read
# at runtime by the deployed static site, so changing it requires a
# rebuild + redeploy, not just restarting a server. On Vercel, set it
# as a Project env var (Settings -> Environment Variables) before
# building, pointing at your deployed backend's real URL, e.g.
# VITE_API_BASE_URL=https://your-space.hf.space/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
